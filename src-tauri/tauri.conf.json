{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todo App",
  "version": "1.1.0",
  "identifier": "com.dmaurelc.todoapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Todo App",
        "width": 414,
        "height": 896,
        "minWidth": 360,
        "minHeight": 640,
        "maxWidth": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["todoapp"]
      },
      "mobile": [
        { "host": "todoapp.app" }
      ]
    }
  }
}
